<%- include('nav') %><main class='container'><h1>Gallery Manager</h1><form method='post' enctype='multipart/form-data'><input type='file' name='image' required><input name='category' placeholder='Food/Interior/Events'><button class='btn'>Upload</button></form><% images.forEach(i=>{ %><div><img src='<%= i.image %>' width='80'><form method='post' action='/admin/gallery/<%= i.id %>/delete'><button>Delete</button></form></div><% }) %></main></body></html>
