<%- include('nav') %><main class='container'><h1>Menu Manager</h1><form method='post' enctype='multipart/form-data' class='form'><input name='name' required><textarea name='description'></textarea><input name='price' type='number' step='0.01'><select name='category_id'><% categories.forEach(c=>{ %><option value='<%= c.id %>'><%= c.name %></option><% }) %></select><label><input type='checkbox' name='is_veg'>Veg</label><label><input type='checkbox' name='is_available' checked>Available</label><input type='file' name='image' accept='image/*'><button class='btn'>Add Item</button></form><% items.forEach(i=>{ %><div><%= i.name %> - $<%= i.price %><form method='post' action='/admin/menu/<%= i.id %>/delete'><button>Delete</button></form></div><% }) %></main></body></html>
