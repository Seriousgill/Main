<%- include('partials/header') %><main class='container'><h1>Our Menu</h1><input id='menuSearch' placeholder='Search dishes'><div id='filters'><button data-filter='all'>All</button><% categories.forEach(c=>{ %><button data-filter='<%= c.name %>'><%= c.name %></button><% }) %></div><div class='grid-3' id='menuGrid'><% menu.forEach(i=>{ %><article class='card menu-item' data-category='<%= i.category_name %>' data-name='<%= i.name.toLowerCase() %>'><img src='<%= i.image || "https://images.unsplash.com/photo-1517244683847-7456b63c5969?w=600" %>'><h3><%= i.name %></h3><p><%= i.description %></p><p>$<%= i.price %> · <%= i.is_veg?"Veg":"Vegan/Non-veg" %> · <%= i.is_available?"In Stock":"Out of Stock" %></p></article><% }) %></div></main><%- include('partials/footer') %>
